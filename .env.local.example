# --- Operator panel ---
# Required to unlock /admin. Pick a strong password and keep it private.
OPERATOR_PASSWORD=change-me

# --- Vercel KV (production) ---
# These four are auto-injected when you provision a KV store in your Vercel project.
# For local development, you can either:
#   1. Leave them blank — the catalog will be saved to .data/stock.json on disk, OR
#   2. Run `vercel env pull .env.local` after linking the project to load the same KV in dev.
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
